// Conflict: samples look uniform, but the code does `next() % 12`. DeG keeps
// both facts, resolves the conflict in favor of the code proof, and records the
// statistical claim as an underpowered hypothesis.

build b1 = binary("../fixtures/game-b1.bin",
  sha256: "470de64c4b572ec064a0e14e1831017dea5c6204f24383f0bc31b9cd474beca6",
  arch: x86_64, load: 0x140000000, text: 0x140001000..0x140001400);

capture c1 = capture("../fixtures/session-b1.pcap",
  sha256: "c9c08a934058673ef36b22a5fb3cd793076ac5cd912018cfe2cc80e86f3abfc2",
  build: b1);

fn loot_roll in b1 at 0x140001100;
rng srv_rng in b1 at 0x140001200 {
  algo: MT19937;
  seed: from(time_seconds@boot);
  scope: per_server_process;
}
dist LootTable in b1 {
  rng: srv_rng;
  site: loot_roll;
  bins: 12;
}

ev e_loot_anchor := scan(b1, ".text", "48 B8 44 65 47 21 62 31 4C 00") |> unique;
ev e_mod := modulo(b1, loot_roll, modulus: 12);
ev e_loot := sample(c1, opcode: 0x02BC, field: 2, width: 2);

rule loot_biased:
  biased(?d, ?m) if
    dist_site(?d, ?f) and
    fn_addr(?f, ?a) and
    scan_hit(?e, ?a) and scan_unique(?e) and
    modulo_op(?e2, ?f, ?m);

proof P_biased : biased(LootTable, 12) in b1 {
  evidence e_loot_anchor, e_mod;
  rules loot_biased;
}

claim C_uniform : uniform(LootTable, bins: 12) in b1 during c1
  provisional until "2099-12-31"
  by e_loot require alpha: 1e-4, power: 0.999, delta: 0.02, coverage >= 100s;

conflict C_loot : C_uniform vs P_biased
  prefer P_biased
  reason "12,000 samples cannot resolve a 2^-32 modular bias; the division by 12 is a Deterministic proof of non-uniformity";

// The kernel checks the sample count, coverage, chi-square p-value and the
// power of the test against the stated 2% alternative. It never promotes the
// uniform claim above Observational, no matter how flat the histogram is.
