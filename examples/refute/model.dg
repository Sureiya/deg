// Generalized refutation: any ground atom can be refuted when the evidence
// carries a `contradicts(ev, rel, [args…])` fact. Here the contradiction
// comes from an external certificate's generic facts array; at the default
// Deterministic seal threshold the refutation is recorded as a hypothesis
// (Observational contradictions cannot seal), never promoted.
//
// Run:
//   deg check examples/refute/model.dg

build b1 = binary("../fixtures/game-b1.bin",
  sha256: "470de64c4b572ec064a0e14e1831017dea5c6204f24383f0bc31b9cd474beca6",
  arch: x86_64, load: 0x140000000, text: 0x140001000..0x140001400);

ev e_contra := external("../fixtures/contradicts.json", kind: contradicts, build: b1);

refute R_can_predict : can_predict(conn_7) in b1 by e_contra;
